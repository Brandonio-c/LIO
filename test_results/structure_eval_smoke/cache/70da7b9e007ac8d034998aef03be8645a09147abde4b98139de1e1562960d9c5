               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Other information</content>
                  </content>
               </title>
               <text>
                  <paragraph>store between 20° and 25°C (68° and 77°F)</paragraph>
               </text>
               <effectiveTime value="20200115"/>
            </section>
