               <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
               <title>KEEP OUT OF REACH OF CHILDREN</title>
               <text>
                  <paragraph>Do not use on infants. If swallowed, get medical help or contact a Poison Control Center right away.</paragraph>
               </text>
               <effectiveTime value="20180428"/>
            </section>
