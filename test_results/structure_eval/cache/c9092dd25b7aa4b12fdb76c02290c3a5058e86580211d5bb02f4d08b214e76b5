               <id root="5528e790-b2b6-0cfd-e063-6294a90a7531"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Use</title>
               <text>
                  <paragraph>helps prevent recurrence of scalp flaking and itching associated with dandruff</paragraph>
               </text>
               <effectiveTime value="20260518"/>
            </section>
         </component>
