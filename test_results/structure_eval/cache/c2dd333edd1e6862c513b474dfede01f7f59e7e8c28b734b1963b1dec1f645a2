               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">Directions</content>
               </title>
               <text>
                  <paragraph>• take only as directed<br/>• do not exceed 8 softgels per 24 hrs</paragraph>
                  <table width="80%">
                     <caption/>
                     <tbody>
                        <tr>
                           <td styleCode="Botrule Lrule Rrule Toprule">adults &amp; children 12 yrs &amp; over</td>
                           <td styleCode="Botrule Lrule Rrule Toprule">2 softgels with water every 4 hrs</td>
                        </tr>
                        <tr>
                           <td styleCode="Botrule Lrule Rrule Toprule">children 4 to under 12 yrs</td>
                           <td styleCode="Botrule Lrule Rrule Toprule">ask a doctor</td>
                        </tr>
                        <tr>
                           <td styleCode="Botrule Lrule Rrule Toprule">children under 4 yrs</td>
                           <td styleCode="Botrule Lrule Rrule Toprule">do not use</td>
                        </tr>
                     </tbody>
                  </table>
                  <paragraph/>
               </text>
               <effectiveTime value="20250908"/>
            </section>
