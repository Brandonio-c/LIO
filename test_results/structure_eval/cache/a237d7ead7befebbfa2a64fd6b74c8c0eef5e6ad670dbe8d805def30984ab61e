               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Warnings</content>
                  </content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">For external use only. </content>
                  </paragraph>
               </text>
               <effectiveTime value="20260809"/>
               <component>
                  <section ID="id_link_56bf3fb1-2482-43d1-e063-6294a90aa4de">
                     <id root="56bf3e0a-d14b-faac-e063-6394a90a0339"/>
                     <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
                     <title>
                        <content styleCode="bold">Do not use</content>
                     </title>
                     <text>
                        <list listType="unordered">
                           <item>on damaged or broken skin</item>
                        </list>
                     </text>
                     <effectiveTime value="20260809"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_56bf4744-dddc-ff20-e063-6394a90a7767">
                     <id root="56bf4744-dddb-ff20-e063-6394a90a7767"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title>
                        <content styleCode="bold">When using this product</content>
                     </title>
                     <text>
                        <list listType="unordered">
                           <item>keep out of eyes. Rinse with water to remove. </item>
                        </list>
                     </text>
                     <effectiveTime value="20260809"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_56bf4cd5-a63a-519f-e063-6294a90a475d">
