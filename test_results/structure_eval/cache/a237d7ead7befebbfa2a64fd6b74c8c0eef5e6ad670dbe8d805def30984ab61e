               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Purpose</content>
                  </content>
               </title>
               <text>
                  <paragraph>Sunscreen</paragraph>
               </text>
               <effectiveTime value="20260809"/>
            </section>
         </component>
         <component>
            <section ID="id_link_56bf3a38-01af-3e8e-e063-6294a90a38e1">
               <id root="56c0bc84-1180-2a2c-e063-6394a90a60c1"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Uses</title>
               <text>
                  <list listType="unordered">
                     <item>Helps prevent sunburn</item>
                     <item>If used with other sun protection measures (see Directions), decreases the risk of early skin aging caused by the sun</item>
                  </list>
               </text>
               <effectiveTime value="20260809"/>
            </section>
         </component>
         <component>
