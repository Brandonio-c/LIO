               <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
               <title>OTHER INFORMATION</title>
               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Other information</content>
                     </content>
                  </paragraph>
                  <list listType="unordered">
                     <item>store at room temperature</item>
                     <item>avoid high temperatures</item>
                     <item>protect from freezing</item>
                     <item>keep away from flame, fire and heat</item>
                  </list>
               </text>
               <effectiveTime value="20251001"/>
            </section>
