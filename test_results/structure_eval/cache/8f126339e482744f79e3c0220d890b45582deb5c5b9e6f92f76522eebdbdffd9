               <text>
                  <paragraph>
                     <content styleCode="italics">
                        <content styleCode="bold">Inactive ingredients</content>
                     </content>
                  </paragraph>
                  <paragraph>Water, Glycerin, Butylene Glycol, Hydroxyethylcellulose, C. Acnes Bacteriophage, Sodium Phosphate, Sodium Chloride, Phenoxyethanol, Polydextrose, Sclerotium Gum, Niacinamide, Magnesium Sulfate, Caffeine, Calcium Chloride.</paragraph>
               </text>
               <effectiveTime value="20251001"/>
            </section>
         </component>
