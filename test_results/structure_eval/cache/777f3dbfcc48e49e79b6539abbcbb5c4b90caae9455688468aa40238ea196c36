               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <text>
                  <paragraph>Purpose: Sunscreen</paragraph>
               </text>
               <effectiveTime value="20171128"/>
            </section>
         </component>
         <component>
            <section ID="L93773052-b96b-47ce-8ddd-50566b0e7bbe">
               <id root="ec272cbf-235b-491c-8e0b-fc76c60c9acc"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <text>
                  <paragraph>Uses:</paragraph>
                  <list listType="unordered">
                     <item>To help protect the skin from harmful UVA and UVB rays</item>
                  </list>
               </text>
               <effectiveTime value="20171128"/>
            </section>
         </component>
         <component>
            <section ID="L1caaf2d0-84a0-4fc5-bad8-51f2330e95a4">
               <id root="aa6caba2-f431-42f4-be96-50792fbda6de"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <text>
                  <paragraph>Warnings: <content>For external use only</content>
                  </paragraph>
               </text>
               <effectiveTime value="20171128"/>
            </section>
         </component>
         <component>
            <section ID="L0b126d18-7d06-4c2a-a92d-9538f8a13c5f">
               <id root="33c85fe6-138c-46f3-9ac9-4a461f18b140"/>
               <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
               <text>
                  <paragraph>When using this product:</paragraph>
                  <list listType="unordered">
                     <item>Keep out of eyes. If contact occurs, rinse with water.</item>
                     <item>Discontinue use if irritation or redness occurs.</item>
                  </list>
               </text>
               <effectiveTime value="20171128"/>
            </section>
         </component>
         <component>
            <section ID="L618406d0-cc7d-409d-8a90-4455f279e554">
               <id root="4c076348-c2f6-4220-a23b-b24fc3d68f39"/>
               <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
               <text>
                  <paragraph>Stop use and ask a doctor</paragraph>
                  <list listType="unordered">
                     <item>If severe skin irritation developes</item>
                  </list>
               </text>
               <effectiveTime value="20171128"/>
            </section>
         </component>
         <component>
            <section ID="L69c46cdc-e643-4e1d-b0eb-bc2a2e03aed6">
               <id root="dcacf314-d0ba-404e-9646-6d72637a8425"/>
               <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
               <text>
                  <paragraph>Keep out of reach of children:</paragraph>
                  <list listType="unordered">
                     <item>If swallowed, get medical help or contact a Poison Cpntrol center right away.</item>
                  </list>
               </text>
               <effectiveTime value="20171128"/>
            </section>
         </component>
         <component>
            <section ID="Lc1c8dc04-adc1-4fb4-8850-a6488c900eaf">
               <id root="27ca89f0-7c90-4386-a9b7-79c1cfb743e3"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <text>
                  <paragraph>Directions:</paragraph>
                  <list listType="unordered">
                     <item>Apply sunscreen in the AM to finger tips and gently massage into the skin. Reapply as needed.</item>
                  </list>
               </text>
               <effectiveTime value="20171128"/>
            </section>
         </component>
