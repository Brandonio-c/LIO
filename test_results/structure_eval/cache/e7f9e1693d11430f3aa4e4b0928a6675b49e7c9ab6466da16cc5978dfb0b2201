            <section ID="Lecf73eb8-0cf0-459e-98a0-90084479ae51">
               <id root="bfb86d46-59c3-4508-a429-5fb8cec2ec0c"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>USES:</title>
               <text>
                  <paragraph>For temporary relief of earache symptoms, such as pain, pressure, congestion, itching, sleeplessness, and headaches, after diagnosis by a physician.</paragraph>
               </text>
               <effectiveTime value="20160824"/>
            </section>
