               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>DIRECTIONS:</title>
               <text>
                  <paragraph>Adults and children 12 years and above:  dissolve 1-2 tablets under tongue, 2 to 3 times daily or as directed by a physician.</paragraph>
                  <paragraph>Children under 12 years, consult a physician.</paragraph>
               </text>
