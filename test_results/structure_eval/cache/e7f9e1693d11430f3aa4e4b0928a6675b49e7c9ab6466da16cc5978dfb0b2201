               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>WARNINGS:</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">• If pregnant or breastfeeding,</content> ask a health professional before use.</paragraph>
                  <paragraph>
                     <content styleCode="bold">• Keep out of reach of children.</content> In case of overdose, get medical help or contact a Poison Control Center right away.</paragraph>
                  <paragraph>
                     <content styleCode="bold">• Stop use and ask a doctor if</content> you experience worsening symptoms or if symptoms last longer than 7 days.</paragraph>
               </text>
               <effectiveTime value="20160824"/>
            </section>
