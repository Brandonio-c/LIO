               <title>
                  <content styleCode="bold">OTHER INFORMATION</content>
               </title>
               <text>
                  <paragraph>Protect the product in this container from excessive heat and direct sunlight</paragraph>
               </text>
               <effectiveTime value="20250214"/>
            </section>
         </component>
