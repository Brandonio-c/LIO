               <code code="51945-4" codeSystem="2.16.840.1.113883.6.1" displayName="PACKAGE LABEL.PRINCIPAL DISPLAY PANEL"/>
               <title>Principal Display Panel</title>
               <text>
                  <paragraph>Compare to the active ingredient in Maximum Strength Mucinex® Fast-Max® Night Time Cold &amp; Flu††</paragraph>
                  <paragraph>
                     <content styleCode="bold">NIGHTTIME</content>
                  </paragraph>
                  <paragraph>Cold &amp; Flu</paragraph>
                  <paragraph>ACETAMINOPHEN / PAIN RELIEVER &amp; FEVER REDUCER</paragraph>
                  <paragraph>DIPHENHYDRAMINE HCI / ANTIHISTAMINE / COUGH SUPPRESSANT</paragraph>
                  <paragraph>PHENYLEPHRINE HCI / NASAL DECONGESTANT</paragraph>
