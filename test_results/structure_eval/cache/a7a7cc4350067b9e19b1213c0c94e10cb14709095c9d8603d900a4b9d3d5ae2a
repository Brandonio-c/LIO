               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredients (in each 20 mL)</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Acetaminophen 650 mg </content>
                  </paragraph>
                  <paragraph>Diphenhydramine HCI 25 mg </paragraph>
                  <paragraph>Phenylephrine HCI 10 mg </paragraph>
               </text>
               <effectiveTime value="20260827"/>
            </section>
