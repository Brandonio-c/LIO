               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">For external use only.</content>
                  </paragraph>
               </text>
               <effectiveTime value="20190315"/>
               <component>
                  <section ID="id_link_5c525a9a-80c3-952f-e063-6294a90a5c71">
                     <id root="5c525a9a-80c2-952f-e063-6294a90a5c71"/>
                     <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
                     <title>Do not use</title>
                     <text>
                        <list listType="unordered">
                           <item>if you are allergic to any of the ingredients</item>
                           <item>in the eyes</item>
                           <item>over large areas of the body</item>
                        </list>
                     </text>
                     <effectiveTime value="20260925"/>
                  </section>
               </component>
               <component>
                  <section>
                     <id root="5c51d6c9-7440-bcde-e063-6394a90ab796"/>
                     <code code="50569-3" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR SECTION"/>
                     <title>Ask a doctor before use if you have</title>
                     <text>
                        <list listType="unordered" styleCode="Disc">
                           <item>deep or puncture wounds</item>
                           <item>animal bites</item>
                           <item>serious burns</item>
                        </list>
                     </text>
                     <effectiveTime value="20190315"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_5c5264aa-513b-a572-e063-6294a90a4037">
                     <id root="5c5264aa-513a-a572-e063-6294a90a4037"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title>Stop use and ask a doctor if</title>
                     <text>
                        <list listType="unordered">
                           <item>you need to use longer than 1 week</item>
                           <item>condition persists or gets worse</item>
                           <item>symptoms persist for more than 1 week, or clear up and occur again within a few days</item>
                           <item>a rash or other allergic reaction develops</item>
                        </list>
                     </text>
                     <effectiveTime value="20260925"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_5c526910-c976-9a17-e063-6394a90aaf5a">
                     <id root="5c526910-c975-9a17-e063-6394a90aaf5a"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <text>
                        <paragraph>
                           <content styleCode="bold">Keep out of reach of children. </content>If swallowed, get medical help or contact a Poison Control Center right away.
 </paragraph>
                     </text>
                     <effectiveTime value="20190315"/>
                  </section>
