               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Uses</title>
               <text>
                  <paragraph>first aid to help prevent infection and for the temporary relief of pain or discomfort in minor:</paragraph>
                  <list listType="unordered" styleCode="Disc">
                     <item>cuts</item>
                     <item>scrapes</item>
                     <item>burns</item>
                  </list>
               </text>
               <effectiveTime value="20190315"/>
            </section>
         </component>
