         <component>
            <section>
               <id root="5c51d6c9-7443-bcde-e063-6394a90ab796"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered" styleCode="Disc">
                     <item>Adults and children 2 years of age and older:
  
   <list listType="unordered" styleCode="Disc">
                           <item>clean the affected area and dry thoroughly</item>
                           <item>apply a small amount of this product (an amount equal to the surface area of the tip of a finger) on the area 1 to 3 times daily</item>
                        </list>
                     </item>
                     <item>may be covered with a sterile bandage</item>
                     <item>Children under 2 years of age: ask a doctor</item>
                  </list>
               </text>
               <effectiveTime value="20190315"/>
            </section>
         </component>
