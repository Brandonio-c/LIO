                     <code code="50568-5" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR/PHARMACIST SECTION"/>
                     <title>
                        <content styleCode="bold">Ask a doctor or pharmacist before use if you are </content>
                     </title>
                     <text>
                        <paragraph>
                           <content styleCode="bold">Ask a doctor or pharmacist before use if you are </content>taking the blood thinning drug warfarin.
 </paragraph>
                     </text>
                     <effectiveTime value="20230801"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_0338c213-e0e5-e5bb-e063-6294a90a15d1">
