               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">Purpose</content>
                  </paragraph>
                  <paragraph>Methyl salicylate 10%   Counterirritant
  <br/>
Camphor 5%   Counterirritant
  <br/>
Capsaicin 0.025%   Counterirritant
 </paragraph>
               </text>
               <effectiveTime value="20261005"/>
            </section>
