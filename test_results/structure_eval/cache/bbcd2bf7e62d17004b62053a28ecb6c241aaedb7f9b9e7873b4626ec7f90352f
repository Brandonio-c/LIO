         <component>
            <section ID="id_link_30c95919-603f-e5a4-e063-6394a90a21ab">
               <id root="30c95919-603e-e5a4-e063-6394a90a21ab"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <text>
                  <paragraph>
                     <content styleCode="bold">
                        <content styleCode="italics">Uses</content>
                     </content>
                  </paragraph>
                  <list listType="unordered">
                     <item>Helps prevent sunburn</item>
                     <item>If used as directed with other sun protection measures (see Directions), decreases the risk of skincancer and early skin aging caused by the sun</item>
                  </list>
               </text>
               <effectiveTime value="20250318"/>
            </section>
