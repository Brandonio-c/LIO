               <title>
                  <content styleCode="italics">Warnings</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">For external use only.</content>
                     </item>
                     <item>﻿Do not ingest. If swallowed, get medical help or contact Poison Control Center immediately.</item>
                     <item>In case of contact with eyes, flush with water.</item>
                  </list>
               </text>
