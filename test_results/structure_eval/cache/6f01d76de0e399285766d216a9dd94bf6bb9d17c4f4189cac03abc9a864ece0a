                     <code code="60561-8" codeSystem="2.16.840.1.113883.6.1" displayName="OTHER SAFETY INFORMATION"/>
                     <title>Other information</title>
                     <text>
                        <paragraph>■ See on the bottom of the bottle for lot number and expiration date.</paragraph>
                        <paragraph>■ Store at room temperature between 68°F (20°C) and 77°F (25°C).</paragraph>
                        <paragraph>■ In rare instances discoloration of gray, blonde, bleached or tinted hair may occur.</paragraph>
                     </text>
                     <effectiveTime value="20250520"/>
                  </section>
               </component>
