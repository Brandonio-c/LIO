               <code code="51727-6" codeSystem="2.16.840.1.113883.6.1" displayName="INACTIVE INGREDIENT SECTION"/>
               <text>
                  <paragraph>Inactive ingredients: Acesulfame potassium, beta carotene, corn starch, eucalyptus oil, glycerin, isomalt, maltitol syrup, medium chain triglycerides, natural and artificial flavors, soybean oil, sucralose and water.</paragraph>
               </text>
               <effectiveTime value="20171009"/>
            </section>
