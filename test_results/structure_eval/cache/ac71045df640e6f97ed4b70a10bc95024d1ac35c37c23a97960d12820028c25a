               <id root="2b0249ec-f17c-d672-e063-6294a90a9448"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>
                  <content styleCode="bold">Purpose</content>
               </title>
               <text>
                  <paragraph>Topical Anesthetic</paragraph>
               </text>
               <effectiveTime value="20230805"/>
            </section>
