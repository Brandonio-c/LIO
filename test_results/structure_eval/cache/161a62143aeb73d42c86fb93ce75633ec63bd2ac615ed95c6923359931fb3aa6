                     <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
                     <title>
                        <content styleCode="bold">Stop use and ask a doctor if</content>
                     </title>
                     <text>
                        <list listType="unordered">
                           <item>redness, irritation, swelling or pain develops or persists for more than 72 hours </item>
                           <item>infection occurs</item>
                        </list>
                     </text>
                     <effectiveTime value="20240901"/>
                  </section>
               </component>
