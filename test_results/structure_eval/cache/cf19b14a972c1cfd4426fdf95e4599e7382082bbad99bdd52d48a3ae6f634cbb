               <code code="42229-5" codeSystem="2.16.840.1.113883.6.1" displayName="SPL UNCLASSIFIED SECTION"/>
               <title>Other information </title>
               <text>
                  <list listType="unordered">
                     <item>1% titratable iodine</item>
                     <item>Avoid excessive heat</item>
                     <item>Store at room temperature</item>
                     <item>For hospital or professional use only</item>
                     <item>Not made with natural rubber latex</item>
                  </list>
               </text>
               <effectiveTime value="20250121"/>
            </section>
