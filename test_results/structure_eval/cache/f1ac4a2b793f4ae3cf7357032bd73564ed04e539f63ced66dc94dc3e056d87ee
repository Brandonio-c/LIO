               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <text>
                  <paragraph>Other information</paragraph>
                  <list listType="unordered">
                     <item>store at 20-25°C (68-77°F)</item>
                     <item>Lot No. &amp; Exp. Date: see box or see crimp of tube</item>
                  </list>
               </text>
               <effectiveTime value="20160121"/>
            </section>
