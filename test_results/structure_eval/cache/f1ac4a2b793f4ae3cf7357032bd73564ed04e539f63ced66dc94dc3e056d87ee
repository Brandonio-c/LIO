               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <text>
                  <paragraph>Active ingredients                                               Purpose</paragraph>
                  <paragraph>Mineral oil 14%..............................................Protectant</paragraph>
                  <paragraph>Petrolatum 74.9%..........................................Protectant</paragraph>
                  <paragraph>Phenylephrine HCI 0.25%..........................Vasconstrictor</paragraph>
               </text>
               <effectiveTime value="20160121"/>
            </section>
