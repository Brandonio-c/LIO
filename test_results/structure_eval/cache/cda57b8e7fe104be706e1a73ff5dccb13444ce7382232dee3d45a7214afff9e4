            <section ID="id_link_48d443c9-51fe-dfa1-e063-6394a90a4b2f">
               <id root="48d443c9-51fd-dfa1-e063-6394a90a4b2f"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Uses</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>temporarily relieves nasal congestion due to a cold</item>
                     <item>hay fever or other upper respiratory allergies</item>
                     <item>sinus congestion and pressure.</item>
                  </list>
               </text>
               <effectiveTime value="20260120"/>
            </section>
         </component>
