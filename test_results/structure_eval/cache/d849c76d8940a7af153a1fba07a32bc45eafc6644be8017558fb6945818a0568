            <section ID="id_link_31642da0-fe60-8d71-e063-6294a90a84d9">
               <id root="31642da0-fe5f-8d71-e063-6294a90a84d9"/>
               <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
               <title>Keep Oot Of Reach Of Children</title>
               <text>
                  <paragraph>Keep out of reach of children If swallowed, get medical help or contact a poison control center (1-800-222-1222) right away.</paragraph>
                  <paragraph/>
               </text>
               <effectiveTime value="20250328"/>
            </section>
         </component>
         <component>
            <section ID="id_link_3164303b-633a-c9b2-e063-6394a90a0c82">
               <id root="3164303b-6339-c9b2-e063-6394a90a0c82"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <paragraph>■ Apply shampoo and massage into the scalp.
  <br/>
■ Leave in hair for 3-5 minutes to allow maximum absorption.
  <br/>
■ Rinse thoroughly with water.
  <br/>
■ Use 2-4 times per week or as needed.
 </paragraph>
               </text>
               <effectiveTime value="20250328"/>
            </section>
         </component>
