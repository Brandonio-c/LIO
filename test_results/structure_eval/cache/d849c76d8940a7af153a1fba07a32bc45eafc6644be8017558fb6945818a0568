         <component>
            <section ID="id_link_31641aae-c465-71c9-e063-6294a90a6410">
               <id root="31641aae-c464-71c9-e063-6294a90a6410"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
               <text>
                  <paragraph>Scalp treatment, fights itching and flaking.</paragraph>
               </text>
               <effectiveTime value="20250328"/>
            </section>
         </component>
         <component>
            <section ID="id_link_3164249b-c3ca-c984-e063-6394a90ae4e2">
               <id root="3164249b-c3c9-c984-e063-6394a90ae4e2"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Use</title>
               <text>
                  <paragraph>Controls and relives symptoms of Dandruff, Psoriasis, Folliculitis and Seborrheic Dermatitis.</paragraph>
               </text>
               <effectiveTime value="20250328"/>
            </section>
         </component>
         <component>
            <section ID="id_link_3164243c-16a9-4b72-e063-6294a90a47b4">
               <id root="3164243c-16a8-4b72-e063-6294a90a47b4"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <paragraph>■ For external use only.
  <br/>
■ Ask a doctore before use if you are allergic to ingredients in this products.
  <br/>
■ When using this product avoid contact with eyes. If contact occurs, flush eyes with copious amounts of cold tap water.
  <br/>
■ Stop use and ask a doctor if condition worsens or does not improve after regular use as directed.
 </paragraph>
               </text>
               <effectiveTime value="20250328"/>
            </section>
         </component>
         <component>
            <section ID="id_link_316426b4-f140-70aa-e063-6294a90a00be">
               <id root="316426b4-f13f-70aa-e063-6294a90a00be"/>
               <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
               <title>Do not use</title>
               <text>
                  <paragraph>If pregnant or breast-feeding ask a health professional before use.
  <br/>
This product is not recommended for individuals under 18 years of age.
 </paragraph>
                  <paragraph/>
               </text>
               <effectiveTime value="20250328"/>
            </section>
         </component>
