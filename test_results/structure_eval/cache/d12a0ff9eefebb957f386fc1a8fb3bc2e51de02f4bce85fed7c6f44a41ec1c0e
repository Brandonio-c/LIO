         <component>
            <section ID="id_link_52f62bd0-686a-b53a-e063-6294a90adda5">
               <id root="5b21b3c6-1cdf-a752-e063-6294a90a7524"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions:</title>
               <text>
                  <paragraph/>
                  <list listType="unordered">
                     <item>Adults and children 12 years of age and over: take 1 tablet a day.</item>
                     <item>
                        <content styleCode="bold">children under 12 years</content>: do not use.
  </item>
                     <item>Do not exceed 4 doses in 24 hours.</item>
                  </list>
                  <paragraph/>
               </text>
               <effectiveTime value="20260701"/>
            </section>
         </component>
