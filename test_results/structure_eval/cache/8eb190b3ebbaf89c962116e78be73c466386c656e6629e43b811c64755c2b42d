                     <text>
                        <paragraph>
                           <content styleCode="bold">Ask a doctor before use if you have</content>
                        </paragraph>
                        <paragraph>● liver disease ● heart disease ● high blood pressure</paragraph>
                        <paragraph>● thyroid disease ● diabetes</paragraph>
                        <paragraph>● cough with excessive phlegm (mucus)</paragraph>
                        <paragraph>● difficulty in urination due to enlargement of the prostate gland</paragraph>
                        <paragraph>● persistent or chronic cough such as occurs with smoking, asthma, 
         or emphysema</paragraph>
                     </text>
                     <effectiveTime value="20220920"/>
                  </section>
               </component>
