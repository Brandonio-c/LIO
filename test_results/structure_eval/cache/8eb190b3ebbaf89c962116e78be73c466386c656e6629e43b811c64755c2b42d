                        <paragraph>
                           <content styleCode="bold">Ask a doctor or pharmacist before use if you are</content> taking the blood thinning drug warfa
        

 </paragraph>
                     </text>
                     <effectiveTime value="20220920"/>
                  </section>
               </component>
