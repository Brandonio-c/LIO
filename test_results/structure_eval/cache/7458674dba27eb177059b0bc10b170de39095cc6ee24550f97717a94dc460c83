                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title> Stop use and ask a doctor if
 <br/>
                     </title>
                     <text>
                        <paragraph> - irritation and redness develop
  <br/>
 - condition persists for more than 72 hours
 </paragraph>
                     </text>
                     <effectiveTime value="20250822"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_3cfad8eb-8320-b457-e063-6294a90a51c8">
