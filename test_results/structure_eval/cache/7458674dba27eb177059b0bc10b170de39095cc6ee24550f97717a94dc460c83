         <component>
            <section ID="id_link_3cfad334-ab0c-6a11-e063-6394a90a8fc2">
               <id root="3cfad334-ab0b-6a11-e063-6394a90a8fc2"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <paragraph>For external use only: hands
  <br/>
 Flammable, keep away from fire or flame.
 </paragraph>
               </text>
               <effectiveTime value="20250822"/>
               <component>
                  <section ID="id_link_3cfad334-ab0e-6a11-e063-6394a90a8fc2">
                     <id root="3cfad334-ab0d-6a11-e063-6394a90a8fc2"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title> When using this product 
 <br/>
                     </title>
                     <text>
                        <paragraph> - keep out of eyes. In case of contact with eyes, flush thoroughly with water.
  <br/>
 - avoid contact with broken skin.
  <br/>
 - do not inhale or ingest.
 </paragraph>
                     </text>
                     <effectiveTime value="20250822"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_3cfad67d-65ba-b095-e063-6294a90adb39">
