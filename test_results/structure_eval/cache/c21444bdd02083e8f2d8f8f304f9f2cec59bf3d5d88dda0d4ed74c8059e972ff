         <component>
            <section ID="id_link_430806f5-d731-9581-e063-6394a90a29a5">
               <id root="4526b6bf-f3e8-0e65-e063-6394a90a6238"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="italics">
                     <content styleCode="bold">Uses</content>
                  </content>
               </title>
               <text>
                  <paragraph>For the cure of most</paragraph>
                  <list listType="unordered">
                     <item>athlete's foot (tinea pedis)</item>
                  </list>
                  <paragraph>For relief og:</paragraph>
                  <list listType="unordered">
                     <item>itching</item>
                     <item>scaling</item>
                     <item>cracking</item>
                     <item>burning</item>
                     <item>redness</item>
                     <item>soreness</item>
                     <item>irritation</item>
                     <item>discomforts which may accompany this condition.</item>
                  </list>
               </text>
               <effectiveTime value="20251204"/>
            </section>
         </component>
