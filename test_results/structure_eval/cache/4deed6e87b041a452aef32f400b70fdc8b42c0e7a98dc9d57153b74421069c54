                     <content styleCode="italics">Other information</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Disc">
                     <item>Each caplet contains very low sodium            <br/>
                     </item>
                     <item>
                        <content styleCode="bold">do not use if carton was opened or if printed foil inner seal under bottle cap is torn or missing</content>
                        <br/>
                     </item>
                     <item>store at room temperature 20º-25º C (68º-77º F)</item>
                  </list>
               </text>
               <effectiveTime value="20200928"/>
            </section>
