                     <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
                     <text>
                        <table cellpadding="4" width="40%">
                           <tbody>
                              <tr>
                                 <td styleCode="Botrule Lrule Rrule Toprule">
                                    <content styleCode="bold">Active ingredient (per caplet)</content>
                                 </td>
                                 <td align="right" styleCode="Botrule Lrule Rrule Toprule" valign="top">
                                    <content styleCode="bold">
                                       <content styleCode="italics">Purposes</content>
                                    </content>
                                 </td>
                              </tr>
                              <tr>
                                 <td styleCode="Botrule Lrule Rrule Toprule" valign="top">Bismuth subsalicylate 262 mg</td>
                                 <td align="right" styleCode="Botrule Lrule Rrule Toprule" valign="top">Anti-diarrheal, Upset stomach reliever </td>
                              </tr>
                           </tbody>
                        </table>
                     </text>
