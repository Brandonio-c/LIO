            <section ID="i4i_warnings_id_cd457b41-15ad-493f-a68e-5b5ad909fbdf">
               <id root="5f6356e6-bff5-c08c-e063-6294a90a610c"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">For external use only</content>
                  </paragraph>
               </text>
               <effectiveTime value="20180409"/>
               <component>
                  <section ID="i4i_OTC_Ask_Doctor_id_8c15dd4b-e083-475c-a02b-f7b7ecb130a1">
                     <id root="5f6356e6-bff6-c08c-e063-6294a90a610c"/>
                     <code code="50569-3" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR SECTION"/>
                     <title>Ask a doctor before use if you have</title>
                     <text>
                        <list listType="unordered">
                           <item>heart disease</item>
                           <item>high blood pressure</item>
                           <item>thyroid disease</item>
                           <item>diabetes</item>
                           <item>trouble urinating due to an enlarged prostate gland</item>
                        </list>
                     </text>
                     <effectiveTime value="20180409"/>
                  </section>
               </component>
               <component>
                  <section ID="i4i_OTC_Ask_Doctor_Pharmacist_id_219f6a93-a3fb-4d81-b67a-bf24875f0560">
                     <id root="5f6356e6-bff7-c08c-e063-6294a90a610c"/>
                     <code code="50568-5" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR/PHARMACIST SECTION"/>
                     <title>Ask a doctor or pharmacist before use if you are</title>
                     <text>
                        <paragraph>presently taking a prescription drug for high blood pressure or depression</paragraph>
                     </text>
                     <effectiveTime value="20090717"/>
                  </section>
               </component>
               <component>
                  <section ID="i4i_OTC_When_Using_id_35b12a41-732e-41c4-a13b-6e6f656f8745">
                     <id root="5f6356e6-bff8-c08c-e063-6294a90a610c"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title>When using this product</title>
                     <text>
                        <list listType="unordered">
                           <item>do not exceed the recommended daily dosage unless directed by a doctor</item>
                           <item>do not put into the rectum by using fingers or any mechanical device or applicator</item>
                        </list>
                     </text>
                     <effectiveTime value="20141113"/>
                  </section>
               </component>
               <component>
                  <section ID="i4i_OTC_Stop_Use_id_f3c10db8-7adc-459b-b168-0662778a660f">
                     <id root="5f6356e6-bff9-c08c-e063-6294a90a610c"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title>Stop use and ask a doctor if</title>
                     <text>
                        <list listType="unordered">
                           <item>bleeding occurs</item>
                           <item>condition worsens or does not improve within 7 days</item>
                           <item>an allergic reaction develops</item>
                           <item>the symptom being treated does not subside or if redness, irritation, swelling, pain, or other symptoms develop or increase</item>
                        </list>
                     </text>
                     <effectiveTime value="20180409"/>
                  </section>
               </component>
