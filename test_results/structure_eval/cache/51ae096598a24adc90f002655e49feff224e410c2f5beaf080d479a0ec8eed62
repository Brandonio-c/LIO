               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <text>
                  <paragraph>Uses
  <br/>
Helps promote and maintain natural resistance to
  <br/>
thrush and alleviates symptoms associated with
  <br/>
yeast infections.
 </paragraph>
                  <paragraph>Directions
  <br/>
To be taken 20 minutes away from food.
  <br/>
Place drops directly under the tongue or into ¼ oz of water.
 </paragraph>
                  <paragraph>
                     <br/>
Adults and adolescents (12 years and older)
 </paragraph>
                  <paragraph>Take 10 drops two to three times daily or as recommended by your healthcare practitioner.</paragraph>
                  <paragraph>Children (under 12 years)</paragraph>
                  <paragraph>Take under the direction of your healthcare practitioner.</paragraph>
               </text>
               <effectiveTime value="20160328"/>
            </section>
