               <title>
                  <content styleCode="italics">Other Information</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>this is a personal care item, and should be used by one individual only</item>
                  </list>
               </text>
               <effectiveTime value="20230820"/>
            </section>
         </component>
