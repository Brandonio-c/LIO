         <component>
            <section ID="Lc2d01b26-af6e-414d-9e84-732d999843f7">
               <id root="0bc674a6-66aa-6ba5-e063-6294a90a854d"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>
                  <content styleCode="italics">Uses</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>helps provide relief of symptoms of cold sores and dry lips</item>
                  </list>
               </text>
               <effectiveTime value="20230820"/>
            </section>
         </component>
         <component>
            <section ID="L58eae69c-e8bf-4b6e-8384-f07a441fd010">
               <id root="0bc674a6-66ab-6ba5-e063-6294a90a854d"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>
                  <content styleCode="italics">Warnings</content>
               </title>
               <text>
                  <paragraph>
                     <content styleCode="bold">For external use only</content>
                  </paragraph>
               </text>
               <effectiveTime value="20230820"/>
               <component>
                  <section ID="Lbe363eaf-0509-45a1-9f26-b7113a27b9a8">
                     <id root="0bc674a6-66ac-6ba5-e063-6294a90a854d"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <title>When using this product:</title>
                     <text>
                        <paragraph>keep out of eyes. Rinse with water to remove.</paragraph>
                     </text>
                     <effectiveTime value="20230820"/>
                  </section>
               </component>
               <component>
                  <section ID="Lfdd5336d-d060-4117-b37a-b590468a6700">
                     <id root="0bc674a6-66ad-6ba5-e063-6294a90a854d"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title>Stop use and ask a doctor if:</title>
                     <text>
                        <list listType="unordered">
                           <item>condition worsens </item>
                           <item>symptoms last more than 7 days or clear up and occur again within a few days</item>
                        </list>
                     </text>
                     <effectiveTime value="20230820"/>
                  </section>
               </component>
               <component>
                  <section ID="Lb5bc53c8-39a1-4544-a3eb-7c6e54fc760f">
                     <id root="0bc674a6-66ae-6ba5-e063-6294a90a854d"/>
                     <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
                     <title>Do not use on:</title>
                     <text>
                        <list listType="unordered">
                           <item>deep puncture wounds </item>
                           <item>serious burns </item>
                           <item>animal bites</item>
                        </list>
                     </text>
                     <effectiveTime value="20230820"/>
                  </section>
               </component>
               <component>
                  <section ID="L972d1b24-b491-4145-b317-e5f23f178d09">
                     <id root="0bc674a6-66af-6ba5-e063-6294a90a854d"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <title>Keep out of reach of children.</title>
                     <text>
                        <paragraph>If swallowed, get medical help or contact a Poison Control Center right away.</paragraph>
                     </text>
                     <effectiveTime value="20230820"/>
                  </section>
               </component>
            </section>
         </component>
         <component>
            <section ID="L120c5ac2-159f-4ac1-a853-96498fd31b86">
               <id root="0bc674a6-66b0-6ba5-e063-6294a90a854d"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="italics">Directions</content>
               </title>
               <text>
                  <list listType="unordered">
                     <item>apply to lips not more than 3 to 4 times daily</item>
                     <item>children under 2 years of age: ask a doctor </item>
                  </list>
               </text>
               <effectiveTime value="20230820"/>
            </section>
         </component>
         <component>
            <section ID="La6ad51e0-1b76-41c3-9cbb-95915fc48601">
               <id root="0bc674a6-66b1-6ba5-e063-6294a90a854d"/>
