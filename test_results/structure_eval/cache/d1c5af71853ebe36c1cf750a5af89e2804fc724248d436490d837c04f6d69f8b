               <title>
                  <content styleCode="italics">Inactive Ingredients</content>
               </title>
               <text>
                  <paragraph>petrolatum, lanolin, euphorbia cerifera wax, isopropyl palmitate, ozokerite, beeswax, cetyl esters, paraffin, theobroma cacao seed butter, flavor, limnanthes alba seed oil, stevia rebaudiana extract</paragraph>
               </text>
               <effectiveTime value="20230820"/>
            </section>
         </component>
