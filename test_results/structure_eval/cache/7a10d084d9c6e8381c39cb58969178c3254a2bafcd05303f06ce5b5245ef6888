               <id root="45cefc8c-f499-7030-e063-6294a90ab2de"/>
               <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
               <title>Keep out of reach of children</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Keep out of reach of children</content>. If swallowed accidentally, get medical help or contact with Poison Control Center immediately.
 </paragraph>
               </text>
               <effectiveTime value="20250915"/>
            </section>
         </component>
         <component>
            <section ID="id_link_4b71f9a6-22cc-64e1-e054-00144ff8d46c">
               <id root="45cdcb62-f83c-c79f-e063-6394a90a8a4b"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">Adult and Children 12 years of age and over</content>:
 </paragraph>
                  <list listType="unordered">
                     <item>Clean and dry the affected area</item>
                     <item>Remove film from patch and apply to the skin </item>
                     <item>Apply 1 patch at a time to affected area, not more than 3 to 4 times daily</item>
                     <item>Remove patch from the skin after at most 8-hour application</item>
                  </list>
                  <paragraph>
                     <content styleCode="bold">Children under 12 years of age</content>: Consult a doctor
 </paragraph>
               </text>
               <effectiveTime value="20250915"/>
            </section>
         </component>
