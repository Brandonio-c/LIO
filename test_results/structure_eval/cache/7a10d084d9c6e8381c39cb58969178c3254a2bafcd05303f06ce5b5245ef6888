               <id root="3ef64cd3-dbd2-14ff-e063-6394a90a49cc"/>
               <code code="50569-3" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR SECTION"/>
               <title>Ask a doctor if:</title>
               <text>
                  <list listType="unordered">
                     <item>localized skin reactions occur, such as rash, itching, redness, irritation, pain, swelling and blistering</item>
                     <item>Conditions worsen</item>
                     <item>Symptoms persists for more than 7 days</item>
                     <item>Symptoms clear up and occur again within a few days</item>
                  </list>
               </text>
               <effectiveTime value="20250915"/>
            </section>
