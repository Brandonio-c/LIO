               <code code="53414-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PREGNANCY OR BREAST FEEDING SECTION"/>
               <title>Pregnancy or breast feeding</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">If pregnant or breast-feeding</content>, ask a health professional before use
 </paragraph>
               </text>
               <effectiveTime value="20250915"/>
            </section>
