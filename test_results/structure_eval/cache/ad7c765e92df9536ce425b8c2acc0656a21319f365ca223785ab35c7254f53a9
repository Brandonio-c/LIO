         <component>
            <section ID="i4i_OTC_Active_Ingredient_id_07d40e0d-6eb3-4c6f-a0be-188486243b08">
               <id root="c54716d3-6ccd-43df-9327-0222150009b0"/>
               <code code="55106-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ACTIVE INGREDIENT SECTION"/>
               <title>Active ingredients (in each gram)</title>
               <text>
                  <paragraph>Bacitracin zinc equivalent to 400 units bacitracin</paragraph>
                  <paragraph>Neomycin sulfate equivalent to 3.5 mg of neomycin base</paragraph>
                  <paragraph>Polymyxin B 5,000 units as polymyxin B sulfate</paragraph>
               </text>
               <effectiveTime value="20150929"/>
            </section>
         </component>
         <component>
            <section ID="i4i_OTC_Purpose_id_3952326a-8327-4514-ab78-d491bf2d2930">
               <id root="468c5200-16b3-4e17-a1df-3e76cb1e274a"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <title>Purpose</title>
               <text>
                  <paragraph>First aid antibiotic</paragraph>
               </text>
               <effectiveTime value="20150929"/>
            </section>
         </component>
         <component>
            <section ID="i4i_indications_id_1f2fc520-f867-4de3-a5e9-f2265b858d16">
               <id root="2793af30-78d5-408b-9d8f-6703c2a2ecd6"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Use</title>
               <text>
                  <paragraph>first aid to help prevent infection in minor:</paragraph>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>cuts</item>
                     <item>
                        <caption>•</caption>scrapes</item>
                     <item>
                        <caption>•</caption>burns</item>
                  </list>
               </text>
               <effectiveTime value="20161121"/>
            </section>
         </component>
         <component>
            <section ID="i4i_warnings_id_8a8d52c9-8208-41c3-b498-0d1e4b9a0b7c">
               <id root="a37e90a4-84fb-4f71-9b90-84390501c9e2"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">For external use only.</content>
                  </paragraph>
               </text>
               <effectiveTime value="20260602"/>
               <component>
                  <section ID="i4i_OTC_Do_not_use_id_88478d62-480f-4b5c-9214-14edccac5b53">
                     <id root="9edf94ab-7147-4d4b-b920-b6731c5fec25"/>
                     <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
                     <title>Do not use</title>
                     <text>
                        <list listType="unordered">
                           <item>
                              <caption>•</caption>if you are allergic to any of the ingredients</item>
                           <item>
                              <caption>•</caption>in the eyes</item>
                           <item>
                              <caption>•</caption>over large areas of the body</item>
                        </list>
                     </text>
                     <effectiveTime value="20150929"/>
                  </section>
               </component>
               <component>
                  <section ID="i4i_OTC_Ask_Doctor_Pharmacist_id_54ae5f96-9f01-4c84-af3a-485263d1374f">
                     <id root="de7c38dc-5f07-46f5-8c58-70e64a7c8465"/>
                     <code code="50568-5" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - ASK DOCTOR/PHARMACIST SECTION"/>
                     <title>Ask a doctor before use if you have</title>
                     <text>
                        <list listType="unordered">
                           <item>
                              <caption>•</caption>deep or puncture wounds</item>
                           <item>
                              <caption>•</caption>animal bites</item>
                           <item>
                              <caption>•</caption>serious burns</item>
                        </list>
                     </text>
                     <effectiveTime value="20150929"/>
                  </section>
               </component>
               <component>
                  <section ID="i4i_OTC_Stop_Use_id_6afb936c-44e6-4e7a-8f7f-fc51f1f7e026">
                     <id root="02486422-0218-4b10-b5e5-e2d7ea2303b6"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <title>Stop use and ask a doctor if</title>
                     <text>
                        <list listType="unordered">
                           <item>
                              <caption>•</caption>you need to use longer than 1 week</item>
                           <item>
                              <caption>•</caption>condition persists or gets worse</item>
                           <item>
                              <caption>•</caption>rash or other allergic reaction develops</item>
                        </list>
                     </text>
                     <effectiveTime value="20150929"/>
                  </section>
               </component>
               <component>
                  <section ID="i4i_OTC_Keep_Away_Children_id_f8b5a209-744d-4272-ace1-96c9308963a8">
                     <id root="e42c4246-1efc-401e-97dd-31dbe10ea2bb"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <title>Keep out of reach of children.</title>
                     <text>
                        <paragraph>If swallowed, get medical help or contact a Poison Control Center right away. (1-800-222-1222)</paragraph>
                     </text>
                     <effectiveTime value="20150929"/>
                  </section>
               </component>
            </section>
         </component>
         <component>
            <section ID="i4i_dosage_admin_id_b15ac100-9ed5-4bb1-9564-5d48ae678fbc">
               <id root="851102ae-7d9a-4c29-a703-d29a4f40ad4e"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <caption>•</caption>clean the affected area</item>
                     <item>
                        <caption>•</caption>apply a small amount of this product (an amount equal to the surface area of the tip of a finger) on the area 1 to 3 times daily</item>
                     <item>
                        <caption>•</caption>may be covered with a sterile bandage</item>
                  </list>
               </text>
               <effectiveTime value="20150929"/>
            </section>
         </component>
