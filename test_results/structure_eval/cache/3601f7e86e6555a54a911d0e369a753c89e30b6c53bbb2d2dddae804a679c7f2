               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <paragraph>
                     <content styleCode="bold italics">For external use only</content>
                  </paragraph>
               </text>
               <effectiveTime value="20251121"/>
               <component>
                  <section>
                     <id root="b5dde8b8-189e-49c3-9979-b137671e40b4"/>
                     <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
                     <text>
                        <paragraph>Do not use on children under 2 years of age unless directed by a doctor.</paragraph>
                        <list>
                           <item>Avoid contact with the eyes.</item>
                           <item>If irritation occurs, discontinue use and consult a doctor.</item>
                        </list>
                     </text>
                     <effectiveTime value="20251121"/>
                  </section>
               </component>
               <component>
                  <section>
