               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>Uses</title>
               <text>
                  <list>
                     <item>Clinically proven to prevent most athlete's foot with daily use and proven clinically effective in the treatment of most athlete's foot</item>
                     <item>For relief of cracking, burning, or itchy, scaly skin between the toes</item>
                     <item>Clears up most athlete's foot infection and with daily use helps keep it from coming back</item>
                  </list>
               </text>
               <effectiveTime value="20251121"/>
            </section>
