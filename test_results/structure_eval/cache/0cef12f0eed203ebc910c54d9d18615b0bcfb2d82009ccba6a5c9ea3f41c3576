         <component>
            <section ID="LINK_00d65e8d-b425-47cd-8905-41904a092acd">
               <id root="7f759ed3-b576-4e28-8d7f-92c6b98db959"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Directions</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>take every 4 to 6 hours, or as directed by a doctor</item>
                  </list>
                  <table width="550px">
                     <col/>
                     <col/>
                     <tbody>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">adults and children 12 years and over</td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">1 tablet. Do not exceed 6 tablets in 24 hours.</td>
                        </tr>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">children 6 to under 12 years</td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">1/2 tablet (break tablet in half). Do not exceed 3 whole tablets in 24 hours.</td>
                        </tr>
                        <tr>
                           <td styleCode=" Botrule Toprule Lrule Rrule">children under 6 years</td>
                           <td styleCode=" Botrule Toprule Lrule Rrule">do not use</td>
                        </tr>
                     </tbody>
                  </table>
               </text>
               <effectiveTime value="20260310"/>
            </section>
         </component>
         <component>
            <section ID="LINK_5bba1dd9-39ce-43b9-9ab4-85fe651bea30">
               <id root="8186d306-4d96-44fb-9134-a3df4fd7dc65"/>
               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>
                  <content styleCode="bold">
                     <content styleCode="italics">Other information</content>
                  </content>
               </title>
               <text>
                  <list listType="unordered" styleCode="Square">
                     <item>
                        <content styleCode="bold">TAMPER EVIDENT: DO NOT USE IF OUTER PACKAGE IS </content>
                        <content styleCode="bold">OPENED OR BLISTER IS TORN OR BROKEN</content>
                        <br/>
                     </item>
                     <item> store at 25°C (77°F); excursions permitted between 15°-30°C (59°-86°F) </item>
                     <item>protect from excessive moisture</item>
                     <item> see end flap for expiration date and lot number</item>
                  </list>
               </text>
               <effectiveTime value="20260310"/>
            </section>
         </component>
