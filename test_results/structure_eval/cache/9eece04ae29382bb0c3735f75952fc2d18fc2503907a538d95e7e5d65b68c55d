               <code code="44425-7" codeSystem="2.16.840.1.113883.6.1" displayName="STORAGE AND HANDLING SECTION"/>
               <title>Other information</title>
               <text>
                  <list listType="unordered">
                     <item>protect this product from excessive heat and direct sun</item>
                     <item>May stain some fabrics</item>
                  </list>
               </text>
               <effectiveTime value="20240116"/>
            </section>
         </component>
