               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>Warnings</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">For external use only</content>
                     </item>
                  </list>
               </text>
               <effectiveTime value="20240116"/>
               <component>
                  <section ID="id_link_0f0c261a-86fe-3d85-e063-6394a90aacb3">
                     <id root="0f0c261a-86fd-3d85-e063-6394a90aacb3"/>
                     <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
                     <text>
                        <list listType="unordered">
                           <item>
                              <content styleCode="bold">Do not use </content>on damaged or broken skin
  </item>
                        </list>
                     </text>
                     <effectiveTime value="20240116"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_0f0c261a-8700-3d85-e063-6394a90aacb3">
                     <id root="0f0c261a-86ff-3d85-e063-6394a90aacb3"/>
                     <code code="50567-7" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - WHEN USING SECTION"/>
                     <text>
                        <list listType="unordered">
                           <item>
                              <content styleCode="bold">When using this product</content> keep out of eyes. Rinse with water to remove.
  </item>
                        </list>
                     </text>
                     <effectiveTime value="20240116"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_0f0c294e-288d-3f17-e063-6394a90a16da">
                     <id root="0f0c294e-288c-3f17-e063-6394a90a16da"/>
                     <code code="50566-9" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - STOP USE SECTION"/>
                     <text>
                        <list listType="unordered">
                           <item>
                              <content styleCode="bold">Stop use and ask a doctor if</content> rash occurs
  </item>
                        </list>
                     </text>
                     <effectiveTime value="20240116"/>
                  </section>
               </component>
               <component>
                  <section ID="id_link_0f0c2f52-3bf2-815d-e063-6294a90ab9dc">
                     <id root="0f0c2f52-3bf1-815d-e063-6294a90ab9dc"/>
                     <code code="50565-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - KEEP OUT OF REACH OF CHILDREN SECTION"/>
                     <text>
                        <list listType="unordered">
                           <item>
                              <content styleCode="bold">Keep out of reach of children</content>. If swallowed, get medical help or contact a Poison Control Center right away
  </item>
                        </list>
                     </text>
                     <effectiveTime value="20240116"/>
                  </section>
