         <component>
            <section ID="id_link_1c80e107-c9ec-e3d1-e063-6394a90a1344">
               <id root="1cac558e-ffb9-25b3-e063-6294a90a3297"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <text>
                  <list listType="unordered">
                     <item>Adults: when practical, clean area with mild soap and warm water and rinse thoroughly. Gently dry by patting or blotting with toilet tissue or soft cloth before applying.</item>
                     <item>Adults and children 12 years and older: apply externally to the affected area up to 4 times a day, especially at night, in the morning, or after each bowel movement.</item>
                     <item>Children under 12 years of age: consult a doctor.</item>
                  </list>
               </text>
               <effectiveTime value="20240705"/>
            </section>
