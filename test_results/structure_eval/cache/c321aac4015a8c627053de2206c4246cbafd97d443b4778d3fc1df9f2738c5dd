               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <title>INDICATIONS</title>
               <text>
                  <paragraph>Condition listed above or as directed by the physician</paragraph>
               </text>
               <effectiveTime value="20240523"/>
            </section>
         </component>
         <component>
            <section ID="L0f97fe14-79c7-4f0c-973e-c35f173bd4ee">
               <id root="19cf43e2-bb3e-b90e-e063-6294a90a8df9"/>
               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>DOSAGE</title>
               <text>
                  <paragraph>Adults: Mix 4-6 drops in 1/2 cup of water, take orally three times daily or as directed by a physician. Children (2 years and older): Take half the adult dose.</paragraph>
               </text>
               <effectiveTime value="20240523"/>
            </section>
         </component>
