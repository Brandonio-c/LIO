            <section ID="id_link_2e312ffc-c780-c29b-e063-6394a90af7e3">
               <id root="2e312ffc-c77f-c29b-e063-6394a90af7e3"/>
               <code code="50570-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - DO NOT USE SECTION"/>
               <title>Do not use</title>
               <text>
                  <paragraph>
                     <br/>
Pregnant women, breastfeeding mothers, children under the age of4 should not use.Do
  <br/>
not use if the skin has abnormalities, wounds, eczema, inflammation, allergies.Please
  <br/>
keep it out of reach of children and pets.
  <br/>
                  </paragraph>
               </text>
               <effectiveTime value="20250215"/>
            </section>
