               <code code="34068-7" codeSystem="2.16.840.1.113883.6.1" displayName="DOSAGE &amp; ADMINISTRATION SECTION"/>
               <title>Directions</title>
               <text>
                  <list listType="unordered">
                     <item>
                        <content styleCode="bold">Adults and children 12 years of age and older:</content> Spray on affected area not more than 4 times daily.
  </item>
                     <item>
                        <content styleCode="bold">Children under 12 years of age:</content> Consult a physician.
  </item>
                  </list>
               </text>
               <effectiveTime value="20260210"/>
            </section>
