               <title>Other information</title>
               <text>
                  <list listType="unordered">
                     <item>store at 20-25°C (68-77°F)</item>
                     <item>store in a cool dry place away from direct sunlight</item>
                  </list>
               </text>
               <effectiveTime value="20260210"/>
            </section>
