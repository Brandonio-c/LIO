               <id root="3b0169a9-2f42-9ace-e063-6394a90aac76"/>
               <code code="55105-1" codeSystem="2.16.840.1.113883.6.1" displayName="OTC - PURPOSE SECTION"/>
               <text>
                  <paragraph>Emergecy bleeding control.</paragraph>
                  <paragraph>For use by trained emergency responders.</paragraph>
               </text>
               <effectiveTime value="20250301"/>
            </section>
         </component>
         <component>
            <section ID="id_link_3b016765-bc4d-9b54-e063-6394a90acd05">
               <id root="3b016765-bc4c-9b54-e063-6394a90acd05"/>
               <code code="34067-9" codeSystem="2.16.840.1.113883.6.1" displayName="INDICATIONS &amp; USAGE SECTION"/>
               <text>
                  <paragraph>1. Open package and remove MED-CLOT.</paragraph>
                  <paragraph>2. Pack MED-CLOT into the wound and use it to apply pressure directly over bleeding source.  More than one MED-CLOT may be required.</paragraph>
                  <paragraph>3. Continue to apply pressure untill bleeding is under control.</paragraph>
                  <paragraph>4. Wrap and tie bandage to maintain pressure. Seek medical care immediately. Show PRODUCT REMOVAL directions on package to medical personnel.</paragraph>
               </text>
               <effectiveTime value="20250301"/>
            </section>
         </component>
         <component>
            <section ID="id_link_3b016765-bc4f-9b54-e063-6394a90acd05">
               <id root="3b016765-bc4e-9b54-e063-6394a90acd05"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <text>
                  <paragraph>For external use only.</paragraph>
                  <paragraph>Sterility not guaranteed if package is damaged.</paragraph>
                  <paragraph>Avoid contact with eyes.</paragraph>
                  <paragraph>Reuse will cause risk of infection and loss of efficacy.</paragraph>
                  <paragraph/>
               </text>
               <effectiveTime value="20250301"/>
            </section>
         </component>
