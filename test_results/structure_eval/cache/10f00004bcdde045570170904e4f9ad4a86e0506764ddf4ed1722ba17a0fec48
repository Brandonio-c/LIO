               <id root="c2dab7aa-8f0f-480e-ad49-eed7cf79a813"/>
               <code code="34071-1" codeSystem="2.16.840.1.113883.6.1" displayName="WARNINGS SECTION"/>
               <title>WARNINGS:</title>
               <text>
                  <paragraph>
                     <content styleCode="bold">If pregnant or breast-feeding,</content> ask a health professional before use.</paragraph>
                  <paragraph>
                     <content styleCode="bold">Keep out of reach of children.</content> In case of overdose, contact a physician or Poison Control Center right away.<br/>
                     <content styleCode="bold">Tamper Evident:</content> Sealed for your protection. Do not use if seal is broken or missing.</paragraph>
               </text>
               <effectiveTime value="20240801"/>
            </section>
         </component>
