{
 "assumptions": [
  {
   "id": "A1",
   "kind": "sample_identity",
   "text": "The scanned tub (UPC 3 00680 41830 1, 'Citrucel Orange', 30 oz) is SPL product NDC 0135-0089 (850 g bottle, 0135-0089-71). The SPL does not carry the UPC; the link is the product name and size on the tub."
  },
  {
   "id": "A2",
   "kind": "label_truth",
   "text": "The SPL (set 9d5f2244, version 17) states the formulation of the physical sample."
  },
  {
   "id": "A3",
   "kind": "rounding",
   "rule_ref": "fda_rounding_101_9@1:calories",
   "text": "The OTC statement 'contributes 60 calories' is rounded like a Nutrition Facts calorie value (21 CFR 101.9(c)(1)); no rule for OTC calorie statements exists."
  },
  {
   "id": "A4",
   "kind": "modelling",
   "rule_ref": "atwater@1",
   "text": "Calories 'from sucrose and maltodextrin' use the general factor of 4 kcal/g for carbohydrate (21 CFR 101.9(c)(1)(i)(B))."
  },
  {
   "id": "A5",
   "kind": "modelling",
   "text": "All calcium comes from dibasic and tricalcium phosphate, in any proportion; no other listed ingredient contains calcium."
  },
  {
   "id": "A6",
   "kind": "modelling",
   "text": "Tricalcium phosphate has its UNII formula Ca3(PO4)2. (Food/USP 'tribasic calcium phosphate' is a variable mixture close to hydroxyapatite, which has more calcium per gram: the true phosphate mass could be lower than this bound.)"
  },
  {
   "id": "A7",
   "kind": "modelling",
   "text": "All potassium comes from potassium citrate (as the UNII monohydrate)."
  },
  {
   "id": "A8",
   "kind": "interpretation",
   "text": "A 'heaping tablespoon' dose is the 19 g in the SPL's strength denominator."
  }
 ],
