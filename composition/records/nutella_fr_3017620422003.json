   "kind": "sample_identity",
   "text": "The sample is the French-market 400 g jar (GTIN 3017620422003); its label is the French ingredient text."
  },
  {
   "id": "E2",
   "kind": "label_truth",
   "text": "The Open Food Facts record (crowd-sourced) transcribes the French label."
  },
  {
   "id": "E3",
   "kind": "interpretation",
   "rule_ref": "quid@1",
   "text": "QUID percentages (Reg. 1169/2011 Art. 22) have no rounding rule; taken as stated, as percent of the finished product at the time of use (Annex VIII 3)."
  },
  {
   "id": "E4",
   "kind": "interpretation",
   "text": "EU nutrition values per 100 g are taken as stated (no rounding rule in the regulation; EU guidance on tolerances is not law)."
  },
  {
   "id": "E5",
   "kind": "modelling",
   "text": "'Sucre' is sucrose (all sugars); 'huile de palme' is all fat."
  },
  {
   "id": "E6",
   "kind": "modelling",
   "text": "Every listed ingredient is present (amount > 0) and they make up the whole product (no moisture loss in manufacture)."
  },
  {
   "id": "E7",
   "kind": "interpretation",
   "rule_ref": "list_ordering@1",
   "text": "Ingredients are in descending order of weight (Reg. 1169/2011 Art. 18), except that ingredients under 2 % may follow in any order (Annex VII Part A); so every ingredient after milk powder (6.6 %) is at most 6.6 %."
  }
